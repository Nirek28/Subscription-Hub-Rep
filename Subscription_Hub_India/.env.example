PORT=4000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=
# Optional in development; required in production. Local MongoDB works.
MONGO_URI=
# Safe default: no live payments or live bank-data access.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_IDS=
RAZORPAY_TOTAL_COUNT=12
MERCHANT_NAME=Subscription Hub Merchant
ENABLE_LIVE_PAYMENTS=false
# Copy the complete v2 FIU API base URL from your Setu Bridge product.
SETU_BASE_URL=https://fiu-sandbox.setu.co/v2
SETU_MODE=sandbox
SETU_PRODUCT_INSTANCE_ID=
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
# Use this instead of client headers if your AA product requires Bearer auth.
SETU_ACCESS_TOKEN=
ENABLE_LIVE_AA=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=
ENABLE_CRON=false
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Kolkata
